BOT_TOKEN=123456:replace_me
OWNER_TG_ID=123456789
ADMIN_TG_IDS=123456789,987654321
# MySQL connection DSN (use 'mysql' host if running MySQL in docker-compose, or 'host.docker.internal' for host machine)
# Option A: Connecting to the MySQL service in docker-compose:
MYSQL_DSN=mysql+aiomysql://root:123456@mysql:3306/audiobookshelf_bot?charset=utf8mb4
# Option B: Connecting to MySQL on the host machine:
# MYSQL_DSN=mysql+aiomysql://absbot:absbot_password@host.docker.internal:3306/audiobookshelf_bot?charset=utf8mb4
ABS_BASE_URL=https://abs.example.com
ABS_API_TOKEN=replace_me
BOT_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
BACKUP_DIR=backups
BACKUP_KEEP_COUNT=7
REGISTRATION_QUEUE_DELAY_SECONDS=2
